{
  "name": "gibous",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "server": "tsx server/server.ts",
    "db:migrate": "tsx server/db/migrate.ts",
    "start": "concurrently \"vite\" \"npm run server\"",
    "typecheck:client": "tsc --noEmit",
    "typecheck:server": "tsc -p server/tsconfig.server.json --noEmit",
    "typecheck": "npm run typecheck:client && npm run typecheck:server",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:component": "vitest run tests/component",
    "test:contract": "vitest run tests/contract",
    "test:security": "vitest run tests/security",
    "test:property": "vitest run tests/property",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ton/core": "^0.62.1",
    "@ton/ton": "^15.4.0",
    "@tonconnect/ui-react": "^3.0.2",
    "buffer": "^6.0.3",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "lucide-react": "^1.16.0",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.3",
    "ws": "^8.18.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15",
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "fast-check": "^4.9.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.2",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.11"
  }
}
