# ==============================================================================
# Gibous Telegram Duel Arena - Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Runtime Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# Leave empty to use high-speed in-memory store for local testing
DATABASE_URL=
PGSSL_REJECT_UNAUTHORIZED=true
ALLOW_IN_MEMORY_DATABASE=false

# ------------------------------------------------------------------------------
# 3. Telegram Bot Configuration (Server-Side)
# ------------------------------------------------------------------------------
# Secret Bot Token from @BotFather (keep secret, never commit real token)
TELEGRAM_BOT_TOKEN=
# Set true only for a local demo adapter; production must keep this false.
ALLOW_UNSIGNED_AUTH=false
# Test-only browser fixture; production startup rejects this when enabled.
E2E_TEST_MODE=false
TELEGRAM_BOT_USERNAME=gibous_bot
TELEGRAM_BOT_APP_NAME=app
# Public HTTPS origin Telegram can fetch the generated brag-card JPEG from.
PUBLIC_APP_URL=https://your-public-host.example
# Optional separate signing secret for short-lived brag-card image URLs.
TELEGRAM_BRAG_SECRET=replace-with-a-random-secret
# Optional full Mini App link used by the outgoing inline button.
TELEGRAM_BOT_APP_URL=https://t.me/gibous_bot/app

# ------------------------------------------------------------------------------
# 4. Client / Frontend Configuration (Vite - exposed with VITE_ prefix)
# ------------------------------------------------------------------------------
# WebSocket Server Endpoint (leave empty for automatic dynamic protocol & host detection)
VITE_WS_URL=
VITE_API_URL=

# Telegram WebApp & Social Links
VITE_TELEGRAM_BOT_USERNAME=gibous_bot
VITE_TELEGRAM_BOT_APP_URL=https://t.me/gibous_bot/app
VITE_COMMUNITY_URL=https://t.me/gibous_community
VITE_SUPPORT_URL=https://t.me/gibous_support

# ------------------------------------------------------------------------------
# 5. TON Blockchain & TON Connect Configuration
# ------------------------------------------------------------------------------
# The implemented verifier supports native TON transfers only. If GRAM is a
# jetton/token contract, use a separate jetton transfer payload and verifier;
# do not deploy this native-asset path with a jetton address.
VITE_TON_ASSET_MODE=native_ton
# Production/mainnet value. Use testnet only in an isolated test deployment.
VITE_TON_NETWORK=mainnet
VITE_SYSTEM_DEPOSIT_ADDRESS=
VITE_TONCONNECT_MANIFEST_URL=https://gibous.fourreal.xyz/tonconnect-manifest.json

# Server-side deposit verification boundary. These must match the client
# network/address at deploy time; production must fail closed if unset.
TON_ASSET_MODE=native_ton
TON_NETWORK=mainnet
TON_DEPOSIT_ADDRESS=
TONCENTER_API_URL=
TONCENTER_API_KEY=
PAYOUT_WORKER_ENABLED=false
